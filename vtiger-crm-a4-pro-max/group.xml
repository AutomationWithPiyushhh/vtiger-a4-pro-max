<!-- Group => collection of "similar"  test methods together is called as group.
				To execute them on a single click without any manual intervention 
				is called as group execution   -->
				
<suite name="suite">
	<groups>
		<run>
			<exclude name="delete" />
		</run>
	</groups>
	<test name="test">
		<classes>
			<class name="types_of_execution.OrgTest" />
			<class name="types_of_execution.ContactTest" />
			<class name="types_of_execution.LeadTest" />
		</classes>
	</test>
</suite>